SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
GROQ_API_KEY=
GROQ_IMAGE_DESCRIPTION_MODEL=qwen/qwen3.8-27b
# SQLite (para desarrollo local)
DATABASE_URL=sqlite:///./artizan.db
# PostgreSQL (descomentar y configurar para producción)
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/artizan_db
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10
# Comma-separated list of allowed origins. Use * to allow all (not recommended in production).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
MODEL_STORAGE=local

# Identificación visual (TODO: completar los IDs reales de Barroco y Cubismo)
CATEGORIA_IDS_INDEXAR=
NOMBRE_COLECCION_IMAGENES=pinturas_imagenes_dino
MODELO_EMBEDDINGS_IMAGEN=facebook/dinov2-small
MODELO_SOLO_LOCAL=true
# TORCH_NUM_THREADS=4
UMBRAL_ENCONTRADA=0.80
UMBRAL_DUDOSA=0.60

# Railway Bucket (usar solo con MODEL_STORAGE=railway)
# BUCKET=
# ACCESS_KEY_ID=
# SECRET_ACCESS_KEY=
# ENDPOINT=
# REGION=
# MODEL_KEY=models/modelo_pinturas_gridsearch.keras